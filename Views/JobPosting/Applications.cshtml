@model Alumni.Models.JobPosting

@{
    var currentLang = Context.Request.Cookies["alumni_language"] ?? "en";
    var isTr = currentLang == "tr";

    var titleEn = Model.Title;
    var titleTr = LocalizeJobTitle(Model.Title, "tr");
    var activeTitle = isTr ? titleTr : titleEn;

    ViewData["Title"] = isTr ? $"Başvurular - {activeTitle}" : $"Applications - {activeTitle}";
    ViewData["ActivePage"] = "JobPostings";

    var posterName = Model.User?.Name ?? $"User #{Model.UserId}";
    var appList = Model.Applications?.ToList() ?? new List<Alumni.Models.Application>();
    var appCount = appList.Count;
}

@functions {
    private static string LocalizeJobTitle(string title, string lang)
    {
        if (string.IsNullOrWhiteSpace(title)) return title;
        if (lang == "tr")
        {
            if (title.Equals("Software Developer", StringComparison.OrdinalIgnoreCase))
                return "Yazılım Geliştirici";
            if (title.Equals("Software Developer Intern", StringComparison.OrdinalIgnoreCase))
                return "Stajyer Yazılım Geliştirici";
            if (title.Equals("Backend Intern", StringComparison.OrdinalIgnoreCase))
                return "Stajyer Arka Yüz Geliştirici";
            if (title.Equals("Data Analyst", StringComparison.OrdinalIgnoreCase))
                return "Veri Analisti";
            if (title.Equals("Business Analyst", StringComparison.OrdinalIgnoreCase))
                return "İş Analisti";
            if (title.Equals("Junior Frontend Developer", StringComparison.OrdinalIgnoreCase))
                return "Ön Yüz Geliştirici";
        }
        return title;
    }
}

<!-- Section 1: Institutional Hero Header -->
<header class="hero-section text-center position-relative overflow-hidden">
    <div class="container py-lg-3 position-relative" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="hero-badge mb-3 text-wrap" style="max-width: 100%;">
                    <i class="bi bi-file-earmark-person-fill" style="color: var(--ats-gold);"></i>
                    <span data-i18n-en="Collegiate Candidate Registry &bull; Applications" data-i18n-tr="Mezun Aday Sicili &bull; Başvurular">
                        Collegiate Candidate Registry &bull; Applications
                    </span>
                </div>
                <h1 class="hero-title mb-3" style="font-size: clamp(1.85rem, 3.2vw, 2.6rem); line-height: 1.3;"
                    data-i18n-en="@titleEn"
                    data-i18n-tr="@titleTr">
                    @activeTitle
                </h1>

                <!-- Editorial Metadata Strip -->
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-3 text-white-50 small mt-2">
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="bi bi-building" style="color: var(--ats-gold);"></i>
                        <span class="text-white fw-semibold">@Model.Company</span>
                    </span>
                    <span>&bull;</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="bi bi-person-circle" style="color: var(--ats-gold);"></i>
                        <span data-i18n-en="Posted by:" data-i18n-tr="Yayınlayan:">Posted by:</span>
                        <span class="text-white">@posterName</span>
                    </span>
                    <span>&bull;</span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <i class="bi bi-people" style="color: var(--ats-gold);"></i>
                        <span class="text-white fw-semibold">@appCount</span>
                        <span data-i18n-en="@(appCount == 1 ? "Registered Candidate" : "Registered Candidates")" data-i18n-tr="@(appCount == 1 ? "Kayıtlı Aday" : "Kayıtlı Aday")">
                            @(appCount == 1 ? "Registered Candidate" : "Registered Candidates")
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Section 2: Application Registry Body -->
<main class="py-5 bg-warm-offwhite" aria-label="Applications Registry">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-lg-11 col-xl-10">

                <!-- Navigation Controls Strip -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <a asp-action="Index" class="btn btn-outline-custom btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>
                        <span data-i18n-en="Back to Career Opportunities" data-i18n-tr="Tüm İlanlara Dön">Back to Career Opportunities</span>
                    </a>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-custom btn-sm">
                        <i class="bi bi-eye me-1" style="color: var(--ats-gold);"></i>
                        <span data-i18n-en="View Position Details" data-i18n-tr="İlan Detayını İncele">View Position Details</span>
                    </a>
                </div>

                <!-- Feedback Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert" style="border-left: 4px solid #198754;">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert" style="border-left: 4px solid #dc3545;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Application Action Card -->
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="card border-0 shadow-sm rounded-3 p-4 mb-4" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-left: 4px solid var(--ats-gold) !important;">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                            <div>
                                <h2 class="h5 academic-serif fw-bold mb-1" style="color: var(--ats-navy);" data-i18n-en="Apply for This Position" data-i18n-tr="Bu İlana Başvur">
                                    Apply for This Position
                                </h2>
                                <p class="text-muted small mb-0">
                                    <span data-i18n-en="You are authenticated as:" data-i18n-tr="Oturum açan kullanıcı:">You are authenticated as:</span>
                                    <strong class="text-dark">@User.Identity.Name</strong>.
                                    <span data-i18n-en="Your collegiate credentials will be transmitted to the hiring alumnus." data-i18n-tr="Mezun bilgileriniz ilan sahibi mezunumuza iletilecektir.">Your collegiate credentials will be transmitted to the hiring alumnus.</span>
                                </p>
                            </div>
                            <form asp-action="Apply" asp-route-id="@Model.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-academic-gold px-4 py-2">
                                    <i class="bi bi-send-fill me-1"></i>
                                    <span data-i18n-en="Submit My Application" data-i18n-tr="Kendi Adıma Başvur">Submit My Application</span>
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm rounded-3 p-4 mb-4" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-left: 4px solid var(--ats-navy) !important;">
                        <div class="d-flex align-items-start gap-3">
                            <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle flex-shrink-0"
                                 style="width: 44px; height: 44px; background: var(--ats-navy); border: 1px solid var(--ats-gold);">
                                <i class="bi bi-shield-lock" style="color: var(--ats-gold); font-size: 1.15rem;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h2 class="h5 academic-serif fw-bold mb-1" style="color: var(--ats-navy);" data-i18n-en="Authentication Required to Submit Applications" data-i18n-tr="Başvuru Yapabilmek İçin Giriş Yapılmalıdır">
                                    Authentication Required to Submit Applications
                                </h2>
                                <p class="text-muted small mb-2" data-i18n-en="Under institutional governance and alumni directory integrity guidelines, submissions on behalf of other members are strictly prohibited. Applications may only be registered under authenticated alumni credentials." data-i18n-tr="Kurumsal yönetim ilkeleri ve mezunlar dizini güvenliği gereğince başka kullanıcılar adına başvuru yapılması engellenmiştir. Başvurular yalnızca doğrulanmış oturum kimliği üzerinden kendi adınıza yapılabilir.">
                                    Under institutional governance and alumni directory integrity guidelines, submissions on behalf of other members are strictly prohibited. Applications may only be registered under authenticated alumni credentials.
                                </p>
                                <button type="button" class="btn btn-outline-custom btn-sm" data-bs-toggle="modal" data-bs-target="#loginNoticeModal">
                                    <i class="bi bi-info-circle me-1" style="color: var(--ats-gold);"></i>
                                    <span data-i18n-en="Single Sign-On (SSO) Notice" data-i18n-tr="Tek Oturum Açma (SSO) Bilgilendirmesi">Single Sign-On (SSO) Notice</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Candidates Registry Card -->
                <div class="card border-0 shadow-sm rounded-3 overflow-hidden" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important;">
                    <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--ats-gray-light) !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-list-check" style="color: var(--ats-gold); font-size: 1.2rem;"></i>
                            <h2 class="h5 academic-serif mb-0" style="color: var(--ats-navy);" data-i18n-en="Registered Candidate Registry" data-i18n-tr="Kayıtlı Aday Sicili">
                                Registered Candidate Registry
                            </h2>
                        </div>
                        <span class="badge" style="background: rgba(197, 164, 109, 0.15); color: var(--ats-gold-hover); border: 1px solid var(--ats-gold-border); font-size: 0.75rem;">
                            <span>@appCount</span> <span data-i18n-en="@(appCount == 1 ? "Record" : "Records")" data-i18n-tr="Kayıt">Records</span>
                        </span>
                    </div>

                    @if (!appList.Any())
                    {
                        <div class="p-5 text-center">
                            <div class="icon-box mx-auto mb-3" style="width: 64px; height: 64px; border-radius: 50%; background: var(--ats-cream); display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: var(--ats-gold);"></i>
                            </div>
                            <h3 class="academic-heading h4 mb-2" data-i18n-en="No Applications Registered Yet" data-i18n-tr="Henüz Başvuru Bulunmuyor">
                                No Applications Registered Yet
                            </h3>
                            <p class="small text-muted mb-0" data-i18n-en="No candidates have applied for this position yet. Once authenticated alumni submit applications, records will be logged in this registry." data-i18n-tr="Bu pozisyon için henüz aday başvurusu yapılmamıştır. Onaylı mezunlar başvurduğunda kayıtlar bu sicilde listelenecektir.">
                                No candidates have applied for this position yet. Once authenticated alumni submit applications, records will be logged in this registry.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" style="font-size: 0.925rem;">
                                <thead style="background: var(--ats-warm-offwhite);">
                                    <tr>
                                        <th scope="col" class="py-3 px-4 text-uppercase small" style="color: var(--ats-gray-muted); font-weight: 700; width: 100px;" data-i18n-en="App ID" data-i18n-tr="Başvuru No">App ID</th>
                                        <th scope="col" class="py-3 px-3 text-uppercase small" style="color: var(--ats-gray-muted); font-weight: 700;" data-i18n-en="Candidate Name" data-i18n-tr="Aday Adı">Candidate Name</th>
                                        <th scope="col" class="py-3 px-3 text-uppercase small" style="color: var(--ats-gray-muted); font-weight: 700;" data-i18n-en="Email Address" data-i18n-tr="E-posta Adresi">Email Address</th>
                                        <th scope="col" class="py-3 px-3 text-uppercase small" style="color: var(--ats-gray-muted); font-weight: 700; width: 130px;" data-i18n-en="Member ID" data-i18n-tr="Üye No">Member ID</th>
                                        <th scope="col" class="py-3 px-4 text-uppercase small text-end" style="color: var(--ats-gray-muted); font-weight: 700; width: 150px;" data-i18n-en="Status" data-i18n-tr="Durum">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in appList)
                                    {
                                        var candidateName = app.User?.Name ?? $"User #{app.UserId}";
                                        <tr>
                                            <td class="px-4 py-3">
                                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.75rem;">
                                                    #@app.Id
                                                </span>
                                            </td>
                                            <td class="px-3 py-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="d-inline-flex align-items-center justify-content-center text-white rounded-circle flex-shrink-0"
                                                         style="width: 32px; height: 32px; background: var(--ats-navy); font-size: 0.8rem; font-weight: 600;">
                                                        @candidateName.Substring(0, 1).ToUpperInvariant()
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block">@candidateName</strong>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-3 py-3 text-muted">
                                                @(app.User?.Email ?? "-")
                                            </td>
                                            <td class="px-3 py-3">
                                                <span class="badge bg-light text-dark border">User #@app.UserId</span>
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                @if (app.Status == "applied")
                                                {
                                                    <span class="badge" style="background: rgba(197, 164, 109, 0.15); color: var(--ats-gold-hover); border: 1px solid var(--ats-gold-border); font-size: 0.75rem; letter-spacing: 0.04em;">
                                                        <i class="bi bi-hourglass-split me-1" style="color: var(--ats-gold);"></i>
                                                        <span data-i18n-en="Applied" data-i18n-tr="Başvuruldu">Applied</span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.75rem;">
                                                        @app.Status
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</main>

<!-- Section 3: Institutional Call-To-Action Banner -->
<section class="py-5 bg-warm-offwhite pt-0" aria-label="Campus Fellowship and Networking Banner">
    <div class="container pb-lg-4">
        <div class="closing-academic-banner text-center">
            <span class="academic-overline" style="color: var(--ats-gold);" data-i18n-en="Collegiate Fellowship" data-i18n-tr="Mezun Dayanışması">
                Collegiate Fellowship
            </span>
            <h2 class="academic-heading text-white mb-3" data-i18n-en="Engage with Our Global Alumni Community" data-i18n-tr="Küresel Mezun Topluluğumuza Katılın">
                Engage with Our Global Alumni Community
            </h2>
            <p class="closing-subtitle mx-auto mb-4" data-i18n-en="Connect with fellow graduates, explore institutional career postings, or submit your own professional opportunities." data-i18n-tr="Mezun arkadaşlarınızla bağlantı kurun, kurumsal kariyer ilanlarını inceleyin veya kendi iş fırsatlarınızı paylaşın.">
                Connect with fellow graduates, explore institutional career postings, or submit your own professional opportunities.
            </p>
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
                <a href="/User" class="btn-academic-gold" data-i18n-en="Explore Alumni Directory" data-i18n-tr="Mezunları Keşfet">
                    Explore Alumni Directory
                </a>
                <a href="/Announcement" class="btn-academic-outline" data-i18n-en="View Campus Bulletins" data-i18n-tr="Kampüs Bültenlerini Oku">
                    View Campus Bulletins
                </a>
                <a href="/" class="btn-academic-ghost text-white-50 text-decoration-none px-3 py-2 small" data-i18n-en="Return to Home &rarr;" data-i18n-tr="Ana Sayfaya Dön &rarr;">
                    Return to Home &rarr;
                </a>
            </div>
        </div>
    </div>
</section>
