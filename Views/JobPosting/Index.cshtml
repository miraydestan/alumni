@model IEnumerable<Alumni.Models.JobPosting>

@{
    ViewData["Title"] = "Job Postings";
    ViewData["ActivePage"] = "JobPostings";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-briefcase me-2 text-primary"></i>Job Postings
            </h1>
            <p class="text-secondary mb-0">Browse career opportunities posted by and for our alumni community.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
            <i class="bi bi-check2-circle me-1"></i>@(Model.Count()) Available Positions
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="info-card text-center py-5">
            <div class="icon-box mx-auto mb-3">
                <i class="bi bi-inbox"></i>
            </div>
            <h3 class="card-heading">No Job Postings Available</h3>
            <p class="card-description mb-0">There are currently no job opportunities listed in the database.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var job in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-primary border px-2 py-1">
                                    <i class="bi bi-building me-1"></i>@job.Company
                                </span>
                                <span class="badge bg-light text-muted border">#@job.Id</span>
                            </div>

                            <h2 class="h5 fw-bold text-dark mb-2">@job.Title</h2>

                            <p class="text-secondary small mb-3">
                                <i class="bi bi-person me-1"></i>Posted by: 
                                <strong>@(job.User?.Name ?? $"User #{job.UserId}")</strong>
                            </p>

                            <div class="mb-4">
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    <i class="bi bi-file-earmark-person me-1"></i>@(job.Applications?.Count ?? 0) Applications
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-custom flex-grow-1 btn-sm">
                                <i class="bi bi-eye me-1"></i> Details
                            </a>
                            <a asp-action="Applications" asp-route-id="@job.Id" class="btn btn-primary-custom flex-grow-1 btn-sm">
                                <i class="bi bi-people me-1"></i> Applications
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
