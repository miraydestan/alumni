@model IEnumerable<Alumni.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
    ViewData["ActivePage"] = "Announcements";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-megaphone me-2 text-primary"></i>Announcements
            </h1>
            <p class="text-secondary mb-0">Stay informed about campus events, reunions, and news from our alumni community.</p>
        </div>
        <a asp-controller="AnnouncementAdmin" asp-action="Index" class="btn btn-outline-custom">
            <i class="bi bi-gear me-1"></i> Manage Announcements
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="info-card text-center py-5">
            <div class="icon-box mx-auto mb-3">
                <i class="bi bi-inbox"></i>
            </div>
            <h3 class="card-heading">No Announcements Yet</h3>
            <p class="card-description mb-3">There are currently no active announcements in the system.</p>
            <a asp-controller="AnnouncementAdmin" asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle me-1"></i> Post First Announcement
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-primary border px-2 py-1">
                                    <i class="bi bi-calendar3 me-1"></i>@item.CreatedDate.ToString("MMM dd, yyyy")
                                </span>
                                <span class="badge bg-light text-muted border">#@item.Id</span>
                            </div>
                            <h2 class="h5 fw-bold text-dark mb-2">@item.Title</h2>
                            <p class="text-secondary mb-4" style="line-height: 1.6;">
                                @(item.Content.Length > 120 ? item.Content.Substring(0, 120) + "..." : item.Content)
                            </p>
                        </div>
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-custom w-100 btn-sm">
                                <i class="bi bi-arrow-right-circle me-1"></i> Read Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
