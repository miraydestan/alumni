@model Alumni.Models.Announcement

@{
    ViewData["Title"] = Model.Title;
    ViewData["ActivePage"] = "Announcements";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <span class="badge bg-light text-primary border px-3 py-2">
                        <i class="bi bi-calendar3 me-1"></i> Posted on @Model.CreatedDate.ToString("MMMM dd, yyyy - HH:mm")
                    </span>
                    <span class="badge bg-light text-secondary border px-2 py-1">Announcement #@Model.Id</span>
                </div>

                <h1 class="h2 fw-bold text-dark mb-4">@Model.Title</h1>

                <div class="p-3 bg-light rounded-3 mb-4 text-secondary" style="font-size: 1.05rem; line-height: 1.8; white-space: pre-line;">
                    @Model.Content
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-custom">
                        <i class="bi bi-arrow-left me-1"></i> Back to Announcements
                    </a>
                    <a asp-controller="AnnouncementAdmin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom">
                        <i class="bi bi-pencil me-1"></i> Edit in Admin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
