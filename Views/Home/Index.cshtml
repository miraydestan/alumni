@{
    ViewData["Title"] = "Home";
    ViewData["ActivePage"] = "Home";
}

<!-- Hero Section -->
<header class="hero-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="hero-badge">
                    <i class="bi bi-mortarboard"></i>
                    <span>University Alumni Network</span>
                </div>
                <h1 class="hero-title">Connect. Discover. Stay Connected.</h1>
                <p class="hero-subtitle">
                    An organized platform for managing alumni information, career journeys and connections.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="#features" class="btn-primary-custom">
                        <span>Explore Alumni</span>
                        <i class="bi bi-arrow-down-short ms-1 fs-5"></i>
                    </a>
                    <a href="/about" class="btn-outline-custom">
                        <span>Learn More</span>
                        <i class="bi bi-arrow-right-short ms-1 fs-5"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Features Section -->
<main class="py-5" id="features">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-dark mb-2">Centralized Alumni Management</h2>
            <p class="text-secondary mx-auto" style="max-width: 600px;">
                Designed specifically to foster continuous engagement, career tracking, and streamlined administrative access.
            </p>
        </div>
        <div class="row g-4">
            <!-- Card 1: Alumni Network -->
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h3 class="card-heading">Alumni Network</h3>
                    <p class="card-description">
                        Üniversite mezunlarını merkezi bir sistemde yönetme ve mezunlar arasındaki iletişimi güçlendiren güvenilir bir ağ sunma.
                    </p>
                </div>
            </div>
            <!-- Card 2: Career & Experience -->
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <h3 class="card-heading">Career & Experience</h3>
                    <p class="card-description">
                        Mezunların çalışma ve kariyer bilgilerinin takip edilmesi, sektör dağılımları ve profesyonel başarılarının izlenmesi.
                    </p>
                </div>
            </div>
            <!-- Card 3: Easy Access -->
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-search"></i>
                    </div>
                    <h3 class="card-heading">Easy Access</h3>
                    <p class="card-description">
                        Mezun bilgilerine daha düzenli ve kolay erişim sağlayan arama ve filtreleme altyapısı ile zamandan tasarruf.
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>
