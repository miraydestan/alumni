</section>

<!-- ========================================================================
     SECTION 4 – ANNOUNCEMENTS (Real Database-Backed Content)
     ======================================================================== -->
<section class="py-5 bg-warm-offwhite" aria-label="Campus Announcements">
    <div class="container py-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-5">
            <div>
                <span class="academic-overline" data-i18n-en="Campus Bulletins" data-i18n-tr="Kampüs Bültenleri">Campus Bulletins</span>
                <h2 class="academic-heading mb-1" data-i18n-en="Official Announcements" data-i18n-tr="Resmi Duyurular">Official Announcements</h2>
                <p class="mb-0 text-muted" data-i18n-en="Recent notices, academic symposiums, and administrative updates." data-i18n-tr="Güncel duyurular, akademik sempozyumlar ve kurumsal bildirimler.">
                    Recent notices, academic symposiums, and administrative updates.
                </p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/Announcement" class="editorial-link" data-i18n-en="View All Announcements &rarr;" data-i18n-tr="Tüm Duyuruları Görüntüle &rarr;">
                    View All Announcements &rarr;
                </a>
            </div>
        </div>

        @if (!recentAnnouncements.Any())
        {
            <!-- Elegant Empty State -->
            <div class="academic-empty-state">
                <i class="bi bi-bell-slash empty-state-icon"></i>
                <h3 class="empty-state-title" data-i18n-en="No Announcements Currently Published" data-i18n-tr="Henüz Yayınlanmış Bir Duyuru Bulunmamaktadır">
                    No Announcements Currently Published
                </h3>
                <p class="empty-state-text" data-i18n-en="Official campus bulletins, academic notices, and alumni announcements will appear here once published." data-i18n-tr="Resmi duyurular, akademik bildirimler ve mezun haberleri yayınlandığında burada listelenecektir.">
                    Official campus bulletins, academic notices, and alumni announcements will appear here once published.
                </p>
            </div>
        }
        else
        {
            <!-- Real Database-Backed Announcement Cards with Complete Bilingual Localization -->
            <div class="row g-4">
                @foreach (var item in recentAnnouncements)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="editorial-record-card">
                            <div>
                                <span class="editorial-date-badge">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    <span data-i18n-en="@item.CreatedDate.ToString("MMMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))" 
                                          data-i18n-tr="@item.CreatedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))">
                                        @item.CreatedDate.ToString("MMMM dd, yyyy", new System.Globalization.CultureInfo("en-US"))
                                    </span>
                                </span>
                                <h3 class="editorial-title" 
                                    data-i18n-en="@LocalizeAnnouncementTitle(item.Title, "en")" 
                                    data-i18n-tr="@item.Title">
                                    @LocalizeAnnouncementTitle(item.Title, "en")
                                </h3>
                                <p class="editorial-content" 
                                   data-i18n-en="@LocalizeAnnouncementContent(item.Title, item.Content, "en")" 
                                   data-i18n-tr="@item.Content">
                                    @LocalizeAnnouncementContent(item.Title, item.Content, "en")
                                </p>
                            </div>
                            <div class="pt-3 border-top" style="border-color: var(--ats-gray-light) !important;">
                                <a asp-controller="Announcement" asp-action="Details" asp-route-id="@item.Id" class="editorial-link" data-i18n-en="Read Full Notice &rarr;" data-i18n-tr="Duyuruyu Oku &rarr;">
                                    Read Full Notice &rarr;
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- ========================================================================
     SECTION 5 – CAREER OPPORTUNITIES (Real Database-Backed Jobs)
     ======================================================================== -->
<section class="py-5 bg-academic-white" aria-label="Career Opportunities">
    <div class="container py-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-5">
            <div>
                <span class="academic-overline" data-i18n-en="Professional Network" data-i18n-tr="Mesleki Ağ">Professional Network</span>
                <h2 class="academic-heading mb-1" data-i18n-en="Career Opportunities" data-i18n-tr="Kariyer Fırsatları">Career Opportunities</h2>
                <p class="mb-0 text-muted" data-i18n-en="Active career positions shared by verified alumni and institutional affiliates." data-i18n-tr="Doğrulanmış mezunlarımız ve kurumsal ortaklarımız tarafından paylaşılan aktif kariyer ilanları.">
                    Active career positions shared by verified alumni and institutional affiliates.
                </p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/JobPosting" class="editorial-link" data-i18n-en="Explore All Opportunities &rarr;" data-i18n-tr="Tüm Fırsatları İncele &rarr;">
                    Explore All Opportunities &rarr;
                </a>
            </div>
        </div>

        @if (!recentJobs.Any())
        {
            <!-- Elegant Empty State -->
            <div class="academic-empty-state">
                <i class="bi bi-briefcase empty-state-icon"></i>
                <h3 class="empty-state-title" data-i18n-en="No Career Opportunities Currently Posted" data-i18n-tr="Henüz İlan Bulunmamaktadır">
                    No Career Opportunities Currently Posted
                </h3>
                <p class="empty-state-text" data-i18n-en="Career openings and recruitment notices published by alumni and partner organizations will appear here." data-i18n-tr="Mezunlarımız ve kurumsal ortaklarımız tarafından paylaşılan kariyer fırsatları burada yer alacaktır.">
                    Career openings and recruitment notices published by alumni and partner organizations will appear here.
                </p>
            </div>
        }
        else
        {
            <!-- Real Database-Backed Job Listings with Bilingual Support -->
            <div class="row g-4">
                @foreach (var job in recentJobs)
                {
                    <div class="col-lg-4 col-md-6">
                        <article class="editorial-job-card">
                            <div>
                                <div class="editorial-job-company">
                                    <i class="bi bi-building me-1"></i>@job.Company
                                </div>
                                <h3 class="editorial-job-title" 
                                    data-i18n-en="@job.Title" 
                                    data-i18n-tr="@LocalizeJobTitle(job.Title, "tr")">
                                    @job.Title
                                </h3>
                                @if (job.User != null && !string.IsNullOrWhiteSpace(job.User.Name))
                                {
                                    <div class="editorial-job-meta mb-3">
                                        <i class="bi bi-person me-1"></i>
                                        <span data-i18n-en="Posted by:" data-i18n-tr="İlan Sahibi:">Posted by:</span>
                                        <strong>@job.User.Name</strong>
                                    </div>
                                }
                            </div>
                            <div class="pt-3 border-top" style="border-color: var(--ats-gray-light) !important;">
                                <a asp-controller="JobPosting" asp-action="Details" asp-route-id="@job.Id" class="editorial-link" data-i18n-en="View Position Details &rarr;" data-i18n-tr="İlan Detaylarını İncele &rarr;">
                                    View Position Details &rarr;
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

