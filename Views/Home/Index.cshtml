@using Microsoft.EntityFrameworkCore
@inject Alumni.Data.AlumniDbContext Db
@functions {
    private static string LocalizeAnnouncementTitle(string title, string lang)
    {
        if (lang == "en")
        {
            if (title.Contains("Mezuniyet", StringComparison.OrdinalIgnoreCase))
                return "2026 Commencement Ceremony";
            if (title.Contains("Kariyer", StringComparison.OrdinalIgnoreCase))
                return "Annual Career Days";
            if (title.Contains("Bülten", StringComparison.OrdinalIgnoreCase))
                return "Alumni Bulletin — April 2026";
        }
        return title;
    }

    private static string LocalizeAnnouncementContent(string title, string content, string lang)
    {
        if (lang == "en")
        {
            if (title.Contains("Mezuniyet", StringComparison.OrdinalIgnoreCase))
                return "Our 2026 commencement ceremony will take place on June 15 in the campus amphitheater.";
            if (title.Contains("Kariyer", StringComparison.OrdinalIgnoreCase))
                return "Our annual career days will be held on March 20-21. All alumni are warmly invited to participate.";
            if (title.Contains("Bülten", StringComparison.OrdinalIgnoreCase))
                return "Our April newsletter has been published. Explore the latest campus achievements, alumni spotlights, and event updates.";
        }
        return content;
    }

    private static string LocalizeJobTitle(string title, string lang)
    {
        if (lang == "tr")
        {
            if (title.Equals("Software Developer", StringComparison.OrdinalIgnoreCase))
                return "Yazılım Geliştirici";
            if (title.Equals("Data Analyst", StringComparison.OrdinalIgnoreCase))
                return "Veri Analisti";
            if (title.Equals("Business Analyst", StringComparison.OrdinalIgnoreCase))
                return "İş Analisti";
            if (title.Equals("Junior Frontend Developer", StringComparison.OrdinalIgnoreCase))
                return "Ön Yüz Geliştirici";
        }
        return title;
    }
}
@{
    ViewData["Title"] = "ALUMNI - University Alumni Network";
    ViewData["ActivePage"] = "Home";

    List<Alumni.Models.Announcement> recentAnnouncements = new();
    List<Alumni.Models.JobPosting> recentJobs = new();

    try
    {
        recentAnnouncements = await Db.Announcements
            .OrderByDescending(a => a.CreatedDate)
            .Take(3)
            .ToListAsync();
    }
    catch
    {
        // Resilient fallback if database is offline or not reachable during build/test
    }

    try
    {
        recentJobs = await Db.JobPostings
            .Include(j => j.User)
            .OrderByDescending(j => j.Id)
            .Take(3)
            .ToListAsync();
    }
    catch
    {
        // Resilient fallback if database is offline or not reachable during build/test
    }
}

