@{
    ViewData["Title"] = "About";
    ViewData["ActivePage"] = "About";
}

<!-- Header Section -->
<header class="hero-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="hero-badge">
                    <i class="bi bi-info-circle"></i>
                    <span>About Platform</span>
                </div>
                <h1 class="hero-title">About Alumni Tracking System</h1>
                <p class="hero-subtitle">
                    Bu sistem, üniversite mezunlarının kariyer yollarını, iletişim bilgilerini ve akademik geçmişlerini takip etmek ve mezunlar arasındaki ağı güçlendirmek amacıyla tasarlanmıştır.
                </p>
            </div>
        </div>
    </div>
</header>

<!-- Main Content: 3 Structured Cards -->
<main class="py-5">
    <div class="container py-2">
        <div class="row g-4 mb-5">
            <!-- Section 1: Our Purpose -->
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon-box">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h2 class="card-heading">Our Purpose</h2>
                    <p class="card-description">
                        Üniversite mezunlarının bilgilerinin düzenli ve merkezi şekilde yönetilmesini sağlamak; akademik geçmiş ile kurumsal hafızayı koruyarak güçlü bir mezun bağı inşa etmek.
                    </p>
                </div>
            </div>

            <!-- Section 2: What We Track -->
            <div class="col-lg-4 col-md-6">
                <div class="info-card">
                    <div class="icon-box">
                        <i class="bi bi-clipboard2-check"></i>
                    </div>
                    <h2 class="card-heading">What We Track</h2>
                    <ul class="track-list">
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Alumni information</span>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Department</span>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Graduation information</span>
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Job / Work Experience</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Section 3: Our Goal -->
            <div class="col-lg-4 col-md-12">
                <div class="info-card">
                    <div class="icon-box">
                        <i class="bi bi-flag"></i>
                    </div>
                    <h2 class="card-heading">Our Goal</h2>
                    <p class="card-description">
                        Üniversite ile mezunlar arasındaki bilgi akışını ve bağlantıyı güçlendiren, mezun dayanışmasını artıran düzenli ve sürdürülebilir bir sistem oluşturmak.
                    </p>
                </div>
            </div>
        </div>

        <!-- Alumni Management Visual Highlight Section -->
        <div class="management-banner">
            <div class="row align-items-center gy-4">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-light text-primary border px-2 py-1 rounded">
                            <i class="bi bi-shield-check me-1"></i> Governance
                        </span>
                        <h3 class="h4 fw-bold text-dark mb-0">Alumni Management Ecosystem</h3>
                    </div>
                    <p class="text-secondary mb-0" style="line-height: 1.6;">
                        Mezun takip altyapısı, akademik birimler ile mezunlar arasında sürekli ve güvenli bir etkileşim kanalı oluşturur. Güncel kariyer verileri sayesinde hem mezunlar kendi aralarında iş birliği yapabilir hem de üniversite kurumsal başarısını takip edebilir.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="/" class="btn-primary-custom px-4">
                        <i class="bi bi-house-door-fill me-2"></i> Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>
