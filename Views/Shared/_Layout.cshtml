<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Alumni Tracking System</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top navbar-custom shadow-sm">
        <div class="container">
            <a class="navbar-brand navbar-brand-custom d-flex align-items-center gap-2" href="/">
                <span class="brand-icon-box">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>Alumni Tracking System</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#atsNavbar" aria-controls="atsNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="atsNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(ViewData["ActivePage"]?.ToString() == "About" ? "active" : "")" href="/about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="/#features">Alumni</a>
                    </li>
                </ul>
                <!-- Future-ready login/portal area -->
                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <a href="/about" class="btn btn-outline-custom btn-sm px-3 py-1">
                        <i class="bi bi-info-circle me-1"></i> Platform Info
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Body -->
    <div class="flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="footer-brand mb-1">Alumni Tracking System</div>
                    <div class="footer-text">Built for university alumni management.</div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 footer-text">
                        <a href="/" class="text-decoration-none text-secondary">Home</a>
                        <span>&bull;</span>
                        <a href="/about" class="text-decoration-none text-secondary">About</a>
                        <span>&bull;</span>
                        <a href="/#features" class="text-decoration-none text-secondary">Features</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
