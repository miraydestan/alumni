@{
    ViewData["Title"] = "404 – Page Not Found";
}

<section class="hero-section text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="info-card text-center py-5 px-4">
                    <div class="hero-badge mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>Error 404</span>
                    </div>
                    <h1 class="hero-title mb-3">404 – Page Not Found</h1>
                    <p class="hero-subtitle mb-4">
                        The page you are looking for could not be found. It may have been moved, deleted, or the URL you entered might be incorrect.
                    </p>
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <a href="/" class="btn-primary-custom">
                            <i class="bi bi-house-door-fill me-2"></i>
                            <span>Back to Home</span>
                        </a>
                        <a href="/about" class="btn-outline-custom">
                            <span>About Platform</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
