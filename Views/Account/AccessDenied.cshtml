@{
    ViewData["Title"] = "Access Denied";
    ViewData["ActivePage"] = "AccessDenied";
}

<header class="hero-section text-center position-relative overflow-hidden">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="hero-badge mb-3">
                    <i class="bi bi-shield-x" style="color: #dc3545;"></i>
                    <span data-i18n-en="Security Protocol &bull; Authorization Gate" data-i18n-tr="Güvenlik Protokolü &bull; Yetkilendirme Kapısı">
                        Security Protocol &bull; Authorization Gate
                    </span>
                </div>
                <h1 class="hero-title mb-3" data-i18n-en="Restricted Administrative Access" data-i18n-tr="Kısıtlı Yönetici Erişimi">
                    Restricted Administrative Access
                </h1>
                <p class="hero-subtitle mb-0" data-i18n-en="You do not possess the required administrative clearance to access this resource." data-i18n-tr="Bu kaynağa erişmek için gerekli yönetici yetkisine sahip değilsiniz.">
                    You do not possess the required administrative clearance to access this resource.
                </p>
            </div>
        </div>
    </div>
</header>

<main class="py-5 bg-warm-offwhite">
    <div class="container py-lg-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card border-0 shadow-sm p-4 p-md-5 text-center" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-top: 3px solid #dc3545 !important; border-radius: 4px;">
                    <div class="icon-box mx-auto mb-4" style="width: 64px; height: 64px; font-size: 1.75rem; background: rgba(220, 53, 69, 0.1); color: #dc3545; border-radius: 50%;">
                        <i class="bi bi-lock-fill"></i>
                    </div>

                    <h2 class="academic-serif mb-3" style="color: var(--ats-navy); font-size: 1.5rem;" data-i18n-en="HTTP 403 &bull; Administrator Role Required" data-i18n-tr="HTTP 403 &bull; Yönetici Rolü Gereklidir">
                        HTTP 403 &bull; Administrator Role Required
                    </h2>

                    <p class="text-muted mb-4 small" style="line-height: 1.6;" data-i18n-en="The administrative portal and data governance controls are strictly restricted to verified system administrators. Your account is currently authenticated with standard privileges." data-i18n-tr="Yönetici paneli ve veri yönetim kontrolleri yalnızca doğrulanmış sistem yöneticilerine açıktır. Hesabınız şu anda standart yetkilerle doğrulanmıştır.">
                        The administrative portal and data governance controls are strictly restricted to verified system administrators. Your account is currently authenticated with standard privileges.
                    </p>

                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a href="/" class="btn btn-academic-gold py-2 px-4 small text-decoration-none" data-i18n-en="Return to Homepage" data-i18n-tr="Ana Sayfaya Dön">
                            <i class="bi bi-house-door me-1"></i>
                            <span data-i18n-en="Return to Homepage" data-i18n-tr="Ana Sayfaya Dön">Return to Homepage</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0 d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-academic-outline py-2 px-4 small w-100" data-i18n-en="Switch Account" data-i18n-tr="Hesap Değiştir">
                                <i class="bi bi-box-arrow-right me-1"></i>
                                <span data-i18n-en="Switch Account" data-i18n-tr="Hesap Değiştir">Switch Account</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
