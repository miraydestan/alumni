@model Alumni.Models.Announcement

@{
    ViewData["Title"] = "Edit Announcement";
    ViewData["ActivePage"] = "AnnouncementAdmin";
}

<!-- Section 1: Institutional Hero Header -->
<header class="hero-section text-center position-relative overflow-hidden">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="hero-badge mb-3">
                    <i class="bi bi-pencil-fill" style="color: var(--ats-gold);"></i>
                    <span data-i18n-en="Administrative Control &bull; Record Revision" data-i18n-tr="Y&ouml;netici Paneli &bull; Kay&#305;t D&uuml;zenleme">
                        Administrative Control &bull; Record Revision
                    </span>
                </div>
                <h1 class="hero-title mb-3" data-i18n-en="Edit Announcement" data-i18n-tr="Duyuruyu D&uuml;zenle">
                    Edit Announcement
                </h1>
                <p class="hero-subtitle mb-0">
                    <span data-i18n-en="Modifying communiqué record" data-i18n-tr="Duyuru kaydı düzenleniyor:">Modifying communiqué record</span>
                    <strong>#@Model.Id</strong> &bull;
                    <span data-i18n-en="Originally published on" data-i18n-tr="İlk yayın tarihi:">Originally published on</span>
                    @Model.CreatedDate.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>
    </div>
</header>

<!-- Section 2: Form Container -->
<main class="py-5 bg-warm-offwhite" aria-label="Edit Announcement Form Section">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8 col-xl-7">
                <div class="card border-0 shadow-sm p-4 p-md-5" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-top: 3px solid var(--ats-navy) !important; border-radius: 4px;">

                    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom" style="border-color: var(--ats-gray-light) !important;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-box m-0" style="width: 48px; height: 48px; font-size: 1.35rem;">
                                <i class="bi bi-pencil-square"></i>
                            </div>
                            <div>
                                <span class="academic-overline mb-1" data-i18n-en="Record Modification" data-i18n-tr="Kay&#305;t Revizyonu">Record Modification</span>
                                <h2 class="academic-serif mb-0" style="color: var(--ats-navy); font-size: 1.5rem;">#@Model.Id &mdash; @Model.Title</h2>
                            </div>
                        </div>
                        <span class="badge" style="background: var(--ats-warm-offwhite); color: var(--ats-navy); border: 1px solid var(--ats-card-border); font-size: 0.85rem; padding: 0.4rem 0.75rem;">
                            ID: #@Model.Id
                        </span>
                    </div>

                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4 rounded" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <!-- Title TR -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold" style="color: var(--ats-navy); font-size: 0.9rem;">
                                <span data-i18n-en="Title (Turkish / Primary) *" data-i18n-tr="Başlık (Türkçe / Birincil) *">Title (Turkish / Primary) *</span>
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg fs-6"
                                   style="border-color: var(--ats-gray-light); border-radius: 4px;" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Title EN -->
                        <div class="mb-4">
                            <label asp-for="TitleEn" class="form-label fw-semibold" style="color: var(--ats-navy); font-size: 0.9rem;">
                                <span data-i18n-en="Title (English - Optional)" data-i18n-tr="Başlık (İngilizce - İsteğe Bağlı)">Title (English - Optional)</span>
                            </label>
                            <input asp-for="TitleEn" class="form-control form-control-lg fs-6"
                                   placeholder="e.g. 2026 Commencement Ceremony Schedule"
                                   data-i18n-en="e.g. 2026 Commencement Ceremony Schedule"
                                   data-i18n-tr="Örn: 2026 Commencement Ceremony Schedule"
                                   style="border-color: var(--ats-gray-light); border-radius: 4px;" />
                            <span asp-validation-for="TitleEn" class="text-danger small"></span>
                        </div>

                        <!-- Content TR -->
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-semibold" style="color: var(--ats-navy); font-size: 0.9rem;">
                                <span data-i18n-en="Content (Turkish / Primary) *" data-i18n-tr="İçerik (Türkçe / Birincil) *">Content (Turkish / Primary) *</span>
                            </label>
                            <textarea asp-for="Content" class="form-control" rows="5"
                                      style="border-color: var(--ats-gray-light); border-radius: 4px;" required></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <!-- Content EN -->
                        <div class="mb-4">
                            <label asp-for="ContentEn" class="form-label fw-semibold" style="color: var(--ats-navy); font-size: 0.9rem;">
                                <span data-i18n-en="Content (English - Optional)" data-i18n-tr="İçerik (İngilizce - İsteğe Bağlı)">Content (English - Optional)</span>
                            </label>
                            <textarea asp-for="ContentEn" class="form-control" rows="5"
                                      placeholder="Write the announcement description in English..."
                                      data-i18n-en="Write the announcement description in English..."
                                      data-i18n-tr="Duyuru metnini İngilizce olarak yazınız (isteğe bağlı)..."
                                      style="border-color: var(--ats-gray-light); border-radius: 4px;"></textarea>
                            <span asp-validation-for="ContentEn" class="text-danger small"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-3 border-top" style="border-color: var(--ats-gray-light) !important;">
                            <button type="submit" class="btn-academic-gold border-0 text-decoration-none py-2 px-4 small">
                                <i class="bi bi-check-circle me-1"></i>
                                <span data-i18n-en="Save Changes" data-i18n-tr="Değişiklikleri Kaydet">Save Changes</span>
                            </button>
                            <a asp-action="Index" class="btn btn-outline-custom py-2 px-3 small">
                                <i class="bi bi-arrow-left me-1"></i>
                                <span data-i18n-en="Back to Registry" data-i18n-tr="Listeye Dön">Back to Registry</span>
                            </a>
                            <a asp-controller="Announcement" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary py-2 px-3 small ms-auto" style="border-color: var(--ats-gray-light); font-size: 0.85rem;">
                                <i class="bi bi-eye me-1"></i>
                                <span data-i18n-en="Preview Public View" data-i18n-tr="Önizle">Preview Public View</span>
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</main>
