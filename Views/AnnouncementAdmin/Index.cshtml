@model IEnumerable<Alumni.Models.Announcement>

@{
    ViewData["Title"] = "Announcement Management";
    ViewData["ActivePage"] = "AnnouncementAdmin";
    var list = Model?.ToList() ?? new List<Alumni.Models.Announcement>();
    var totalCount = list.Count;
}

<!-- Section 1: Institutional Hero Header -->
<header class="hero-section text-center position-relative overflow-hidden">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="hero-badge mb-3">
                    <i class="bi bi-shield-lock-fill" style="color: var(--ats-gold);"></i>
                    <span data-i18n-en="Administrative Portal &bull; Communiqu&eacute;s" data-i18n-tr="Y&ouml;netici Paneli &bull; Resm&icirc; Tebli&#287;ler">
                        Administrative Portal &bull; Communiqu&eacute;s
                    </span>
                </div>
                <h1 class="hero-title mb-3" data-i18n-en="Announcement Management" data-i18n-tr="Duyuru Y&ouml;netimi">
                    Announcement Management
                </h1>
                <p class="hero-subtitle mb-0" data-i18n-en="Institutional control panel to draft, edit, and publish official announcements for the university alumni network." data-i18n-tr="Üniversite mezunlar ağına yönelik resmî duyuruları oluşturmak, düzenlemek ve yayımlamak için kurumsal yönetim paneli.">
                    Institutional control panel to draft, edit, and publish official announcements for the university alumni network.
                </p>
            </div>
        </div>
    </div>
</header>

<!-- Section 2: Management Controls & Announcement Registry Table -->
<main class="py-5 bg-warm-offwhite" aria-label="Announcement Management Section">
    <div class="container py-lg-3">

        <!-- Controls Toolbar: Search & Action Buttons -->
        <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 mb-4" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important;">
            <div class="row g-3 align-items-center justify-content-between">
                <!-- Search Input -->
                <div class="col-12 col-md-6 col-lg-5">
                    <label for="adminAnnouncementSearchInput" class="visually-hidden">Search Announcements</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-color: var(--ats-gray-light); color: var(--ats-gold);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="adminAnnouncementSearchInput" class="form-control border-start-0 ps-0"
                               placeholder="Search by title, content, or ID..."
                               data-i18n-en="Search by title, content, or ID..."
                               data-i18n-tr="Başlık, içerik veya ID ile ara..."
                               style="border-color: var(--ats-gray-light);" />
                    </div>
                </div>

                <!-- Action Cluster: Public View & New Announcement -->
                <div class="col-12 col-md-6 col-lg-6 text-md-end d-flex justify-content-start justify-content-md-end gap-2 flex-wrap">
                    <a asp-controller="Announcement" asp-action="Index" class="btn btn-outline-custom">
                        <i class="bi bi-eye me-1" style="color: var(--ats-gold);"></i>
                        <span data-i18n-en="Public View" data-i18n-tr="Kamuya Açık Görünüm">Public View</span>
                    </a>
                    <a asp-action="Create" class="btn-academic-gold text-decoration-none py-2 px-3 small">
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        <span data-i18n-en="New Announcement" data-i18n-tr="Yeni Duyuru">New Announcement</span>
                    </a>
                </div>
            </div>

            <!-- Active Records Counter Strip -->
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 pt-3 mt-3 border-top" style="border-color: var(--ats-gray-light) !important;">
                <div class="small" style="color: var(--ats-gray-muted);">
                    <span data-i18n-en="Showing" data-i18n-tr="Gösterilen:">Showing</span>
                    <strong id="adminVisibleCount" class="text-dark">@totalCount</strong>
                    <span data-i18n-en="of" data-i18n-tr="/">of</span>
                    <strong class="text-dark">@totalCount</strong>
                    <span data-i18n-en="recorded communiqu&eacute;s" data-i18n-tr="kayıtlı duyuru">recorded communiqu&eacute;s</span>
                </div>
                <div class="small fw-semibold text-uppercase" style="color: var(--ats-gold); letter-spacing: 0.08em; font-size: 0.75rem;" data-i18n-en="Institutional Database &bull; Active Registry" data-i18n-tr="Kurumsal Veritabanı &bull; Aktif Kayıtlar">
                    Institutional Database &bull; Active Registry
                </div>
            </div>
        </div>

        @if (!list.Any())
        {
            <!-- Empty State -->
            <div class="card border-0 shadow-sm p-5 text-center my-4" style="background: #FFFFFF; border: 1px dashed var(--ats-gray-light) !important; border-radius: 4px;">
                <div class="mx-auto mb-3" style="width: 56px; height: 56px; border-radius: 4px; background: var(--ats-warm-offwhite); color: var(--ats-gold); border: 1px solid var(--ats-gold-border); display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                    <i class="bi bi-megaphone"></i>
                </div>
                <h3 class="academic-serif mb-2" style="color: var(--ats-navy); font-size: 1.4rem;" data-i18n-en="No Announcements Found" data-i18n-tr="Kayıtlı Duyuru Bulunamadı">
                    No Announcements Found
                </h3>
                <p class="text-muted mb-4 mx-auto" style="max-width: 480px; font-size: 0.95rem;" data-i18n-en="The announcement database currently contains no records. Use the action below to publish the first institutional communiqué." data-i18n-tr="Duyuru veritabanında henüz kayıt bulunmuyor. İlk kurumsal duyuruyu yayımlamak için aşağıdaki düğmeyi kullanabilirsiniz.">
                    The announcement database currently contains no records. Use the action below to publish the first institutional communiqué.
                </p>
                <div>
                    <a asp-action="Create" class="btn-academic-gold text-decoration-none py-2 px-4 small">
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        <span data-i18n-en="Create First Announcement" data-i18n-tr="İlk Duyuruyu Oluştur">Create First Announcement</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Announcements Table Card -->
            <div class="card border-0 shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-radius: 4px; overflow: hidden;">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="adminAnnouncementsTable">
                        <thead style="background-color: var(--ats-warm-offwhite); border-bottom: 2px solid var(--ats-gold-border);">
                            <tr>
                                <th scope="col" style="width: 90px; color: var(--ats-navy); font-size: 0.785rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; padding: 1rem 1.25rem;">
                                    ID
                                </th>
                                <th scope="col" style="min-width: 220px; color: var(--ats-navy); font-size: 0.785rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; padding: 1rem 1rem;" data-i18n-en="Title &amp; Subject" data-i18n-tr="Başlık ve Konu">
                                    Title &amp; Subject
                                </th>
                                <th scope="col" class="d-none d-md-table-cell" style="color: var(--ats-navy); font-size: 0.785rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; padding: 1rem 1rem;" data-i18n-en="Content Preview" data-i18n-tr="İçerik Özeti">
                                    Content Preview
                                </th>
                                <th scope="col" style="width: 170px; color: var(--ats-navy); font-size: 0.785rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; padding: 1rem 1rem;" data-i18n-en="Date" data-i18n-tr="Tarih">
                                    Date
                                </th>
                                <th scope="col" class="text-end" style="width: 220px; color: var(--ats-navy); font-size: 0.785rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; padding: 1rem 1.25rem;" data-i18n-en="Actions" data-i18n-tr="İşlemler">
                                    Actions
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in list)
                            {
                                var previewText = item.Content.Length > 90 ? item.Content.Substring(0, 90) + "..." : item.Content;
                                <tr class="admin-announcement-row" data-search="@item.Id @item.Title @item.TitleEn @item.Content @item.ContentEn">
                                    <td style="padding: 1rem 1.25rem;">
                                        <span class="badge" style="background: var(--ats-warm-offwhite); color: var(--ats-navy); border: 1px solid var(--ats-card-border); font-weight: 600; font-size: 0.8rem; padding: 0.35rem 0.6rem;">
                                            #@item.Id
                                        </span>
                                    </td>
                                    <td style="padding: 1rem 1rem;">
                                        <div class="fw-semibold" style="color: var(--ats-navy); font-size: 0.95rem;">
                                            @item.Title
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.TitleEn))
                                        {
                                            <div class="small text-muted fst-italic">
                                                @item.TitleEn
                                            </div>
                                        }
                                    </td>
                                    <td class="d-none d-md-table-cell" style="padding: 1rem 1rem; color: var(--ats-gray-muted); font-size: 0.885rem;">
                                        @previewText
                                    </td>
                                    <td style="padding: 1rem 1rem; color: var(--ats-gray-muted); font-size: 0.85rem; white-space: nowrap;">
                                        <i class="bi bi-calendar3 me-1" style="color: var(--ats-gold);"></i>
                                        <span>@item.CreatedDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="text-end" style="padding: 1rem 1.25rem; white-space: nowrap;">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-controller="Announcement" asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary" title="View Public Article"
                                               style="border-color: var(--ats-gray-light); font-size: 0.8rem;">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-lg-inline ms-1" data-i18n-en="View" data-i18n-tr="Gör">View</span>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-primary" title="Edit Announcement"
                                               style="border-color: var(--ats-navy); color: var(--ats-navy); font-size: 0.8rem;">
                                                <i class="bi bi-pencil"></i>
                                                <span class="d-none d-lg-inline ms-1" data-i18n-en="Edit" data-i18n-tr="Düzenle">Edit</span>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger" title="Delete Announcement"
                                               style="font-size: 0.8rem;">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-lg-inline ms-1" data-i18n-en="Delete" data-i18n-tr="Sil">Delete</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Client Filter No Match Message -->
            <div id="adminNoMatchState" class="card border-0 shadow-sm p-5 text-center my-3 d-none" style="background: #FFFFFF; border: 1px dashed var(--ats-gray-light) !important; border-radius: 4px;">
                <div class="mx-auto mb-2" style="width: 48px; height: 48px; border-radius: 4px; background: var(--ats-warm-offwhite); color: var(--ats-gold); border: 1px solid var(--ats-gold-border); display: inline-flex; align-items: center; justify-content: center; font-size: 1.35rem;">
                    <i class="bi bi-search"></i>
                </div>
                <h4 class="academic-serif mb-1" style="color: var(--ats-navy); font-size: 1.2rem;" data-i18n-en="No Matching Communiqu&eacute;s" data-i18n-tr="Eşleşen Duyuru Bulunamadı">
                    No Matching Communiqu&eacute;s
                </h4>
                <p class="text-muted small mb-0" data-i18n-en="No announcements matched your search query. Try searching with different terms." data-i18n-tr="Arama kriterlerinize uyan duyuru bulunamadı. Lütfen farklı terimlerle arama yapmayı deneyin.">
                    No announcements matched your search query. Try searching with different terms.
                </p>
            </div>
        }

    </div>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var searchInput = document.getElementById('adminAnnouncementSearchInput');
            var rows = document.querySelectorAll('.admin-announcement-row');
            var counter = document.getElementById('adminVisibleCount');
            var noMatch = document.getElementById('adminNoMatchState');
            var table = document.getElementById('adminAnnouncementsTable');

            if (!searchInput || !rows.length) return;

            searchInput.addEventListener('input', function () {
                var query = searchInput.value.toLowerCase().trim();
                var visibleCount = 0;

                rows.forEach(function (row) {
                    var data = (row.getAttribute('data-search') || '').toLowerCase();
                    if (query === '' || data.indexOf(query) !== -1) {
                        row.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        row.classList.add('d-none');
                    }
                });

                if (counter) counter.textContent = visibleCount;

                if (noMatch) {
                    if (visibleCount === 0 && query !== '') {
                        noMatch.classList.remove('d-none');
                        if (table) table.closest('.card').classList.add('d-none');
                    } else {
                        noMatch.classList.add('d-none');
                        if (table) table.closest('.card').classList.remove('d-none');
                    }
                }
            });
        });
    </script>
}
