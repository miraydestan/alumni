@model IEnumerable<Alumni.Models.Announcement>

@{
    ViewData["Title"] = "Announcement Management";
    ViewData["ActivePage"] = "AnnouncementAdmin";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock me-2 text-primary"></i>Announcement Management
            </h1>
            <p class="text-secondary mb-0">Admin control panel to create, update, and remove announcements.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Announcement" asp-action="Index" class="btn btn-outline-custom">
                <i class="bi bi-eye me-1"></i> Public View
            </a>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle me-1"></i> New Announcement
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="info-card text-center py-5">
            <div class="icon-box mx-auto mb-3">
                <i class="bi bi-megaphone"></i>
            </div>
            <h3 class="card-heading">No Announcements Found</h3>
            <p class="card-description mb-3">The announcement repository is currently empty.</p>
            <a asp-action="Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-circle me-1"></i> Create First Announcement
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 80px;">ID</th>
                            <th scope="col" style="width: 250px;">Title</th>
                            <th scope="col">Content Preview</th>
                            <th scope="col" style="width: 160px;">Created Date</th>
                            <th scope="col" class="text-end" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">#@item.Id</span>
                                </td>
                                <td class="fw-semibold text-dark">@item.Title</td>
                                <td class="text-secondary small">
                                    @(item.Content.Length > 80 ? item.Content.Substring(0, 80) + "..." : item.Content)
                                </td>
                                <td class="text-secondary small">
                                    <i class="bi bi-clock me-1"></i>@item.CreatedDate.ToString("MMM dd, yyyy")
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-controller="Announcement" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
