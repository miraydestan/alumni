@model Alumni.Models.Announcement

@{
    ViewData["Title"] = "Delete Announcement";
    ViewData["ActivePage"] = "AnnouncementAdmin";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="icon-box m-0 bg-danger-subtle text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div>
                        <h2 class="card-heading mb-0 text-danger">Delete Announcement</h2>
                        <span class="text-secondary small">Are you sure you want to permanently remove this announcement?</span>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small mb-4">
                    <i class="bi bi-info-circle me-1"></i> This action will delete the announcement from the in-memory list.
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small d-block">ID</span>
                    <span class="fs-6 fw-semibold text-dark">#@Model.Id</span>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small d-block">Title</span>
                    <span class="fs-5 fw-semibold text-dark">@Model.Title</span>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small d-block">Created Date</span>
                    <span class="fs-6 text-secondary">@Model.CreatedDate.ToString("MMMM dd, yyyy - HH:mm")</span>
                </div>

                <div class="mb-4">
                    <span class="text-muted small d-block">Content</span>
                    <p class="fs-6 text-secondary mb-0" style="white-space: pre-line;">@Model.Content</p>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Delete Announcement
                        </button>
                        <a asp-action="Index" class="btn btn-outline-custom px-3">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
