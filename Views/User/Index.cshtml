@model IEnumerable<Alumni.Models.User>

@{
    ViewData["Title"] = "Alumni Directory";
    ViewData["ActivePage"] = "Users";
}

@functions {
    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "AL";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}

<!-- Section 1: Institutional Hero Header -->
<header class="hero-section text-center">
    <div class="container py-lg-3">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="hero-badge mb-3">
                    <i class="bi bi-mortarboard-fill" style="color: var(--ats-gold);"></i>
                    <span data-i18n-en="Alumni Directory &bull; Institutional Registry" data-i18n-tr="Mezunlar Dizini &bull; Kurumsal Sicil">
                        Alumni Directory &bull; Institutional Registry
                    </span>
                </div>
                <h1 class="hero-title mb-3" data-i18n-en="Alumni Directory" data-i18n-tr="Mezunlar Dizini">
                    Alumni Directory
                </h1>
                <p class="hero-subtitle mb-0" data-i18n-en="Discover, connect, and collaborate with distinguished university graduates across cohorts, faculties, and professional fields." data-i18n-tr="Dönemler, fakülteler ve mesleki alanlar genelinde seçkin üniversite mezunlarımızı keşfedin, iletişim kurun ve iş birliği geliştirin.">
                    Discover, connect, and collaborate with distinguished university graduates across cohorts, faculties, and professional fields.
                </p>
            </div>
        </div>
    </div>
</header>

<!-- Section 2: Directory Controls & Alumni Listing -->
<main class="py-5 bg-warm-offwhite" aria-label="Alumni Directory Section">
    <div class="container py-lg-3">

        <!-- Controls Toolbar: Search, Filters & Registration Action -->
        <div class="card border-0 shadow-sm rounded-3 p-3 p-md-4 mb-5" style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important;">
            <div class="row g-3 align-items-center justify-content-between">
                <!-- Search Input -->
                <div class="col-12 col-md-5 col-lg-5">
                    <label for="alumniSearchInput" class="visually-hidden">Search Alumni</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-color: var(--ats-gray-light); color: var(--ats-gold);">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="alumniSearchInput" class="form-control border-start-0 ps-0" 
                               placeholder="Search by name, email, or ID..." 
                               data-i18n-en="Search by name, email, or ID..." 
                               data-i18n-tr="İsim, e-posta veya ID ile ara..." 
                               style="border-color: var(--ats-gray-light);" />
                    </div>
                </div>

                <!-- Sort & Filter Dropdown -->
                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <label for="alumniSortSelect" class="visually-hidden">Sort Directory</label>
                    <select id="alumniSortSelect" class="form-select" style="border-color: var(--ats-gray-light); font-size: 0.9rem;">
                        <option value="recent" data-i18n-en="Most Recent First" data-i18n-tr="En Yeni Kayıtlar">Most Recent First</option>
                        <option value="name-asc" data-i18n-en="Name (A to Z)" data-i18n-tr="İsim (A - Z)">Name (A to Z)</option>
                        <option value="name-desc" data-i18n-en="Name (Z to A)" data-i18n-tr="İsim (Z - A)">Name (Z to A)</option>
                        <option value="id-asc" data-i18n-en="ID (Ascending)" data-i18n-tr="Sicil No (Artan)">ID (Ascending)</option>
                    </select>
                </div>

                <!-- Action Cluster: Quick Register Toggle & Full Page Link -->
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 text-sm-end d-flex justify-content-start justify-content-sm-end gap-2 flex-wrap">
                    <button class="btn btn-outline-custom" type="button" data-bs-toggle="collapse" data-bs-target="#quickRegisterCollapse" aria-expanded="false" aria-controls="quickRegisterCollapse">
                        <i class="bi bi-person-plus me-1" style="color: var(--ats-gold);"></i>
                        <span data-i18n-en="Quick Add" data-i18n-tr="Hızlı Ekle">Quick Add</span>
                    </button>
                    <a asp-action="Create" class="btn-academic-gold text-decoration-none py-2 px-3 small">
                        <span data-i18n-en="New Registration" data-i18n-tr="Yeni Kayıt">New Registration</span>
                    </a>
                </div>
            </div>

            <!-- Active Directory Counter Strip -->
            <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 pt-3 mt-3 border-top" style="border-color: var(--ats-gray-light) !important;">
                <div class="small" style="color: var(--ats-gray-muted);">
                    <span data-i18n-en="Showing" data-i18n-tr="Gösterilen:">Showing</span>
                    <strong id="alumniVisibleCount" class="text-dark">@Model.Count()</strong>
                    <span data-i18n-en="of" data-i18n-tr="/">of</span>
                    <strong class="text-dark">@Model.Count()</strong>
                    <span data-i18n-en="verified alumni members" data-i18n-tr="doğrulanmış mezun üyesi">verified alumni members</span>
                </div>
                <div class="small fw-semibold text-uppercase" style="color: var(--ats-gold); letter-spacing: 0.08em; font-size: 0.75rem;" data-i18n-en="Official Collegiate Roster" data-i18n-tr="Resmi Mezuniyet Sicili">
                    Official Collegiate Roster
                </div>
            </div>
        </div>

        <!-- Collapsible Quick Register Form (Preserves POST /users action) -->
        <div class="collapse mb-5" id="quickRegisterCollapse">
            <div class="card border-0 shadow-sm rounded-3 p-4 p-md-4" style="background: #FFFFFF; border-left: 4px solid var(--ats-gold) !important; border: 1px solid var(--ats-card-border);">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="icon-box m-0" style="width: 36px; height: 36px; font-size: 1rem;">
                            <i class="bi bi-person-plus-fill"></i>
                        </span>
                        <div>
                            <h2 class="h5 academic-serif mb-0" style="color: var(--ats-navy);" data-i18n-en="Quick Alumni Registration" data-i18n-tr="Hızlı Mezun Kaydı">
                                Quick Alumni Registration
                            </h2>
                            <span class="small" style="color: var(--ats-gray-muted);" data-i18n-en="Add a verified graduate directly to the platform database" data-i18n-tr="Doğrulanmış mezunu doğrudan veritabanına kaydedin">
                                Add a verified graduate directly to the platform database
                            </span>
                        </div>
                    </div>
                    <a asp-action="Create" class="small text-decoration-none" style="color: var(--ats-navy);" data-i18n-en="Open Full Form &rarr;" data-i18n-tr="Detaylı Form &rarr;">
                        Open Full Form &rarr;
                    </a>
                </div>

                <form action="/users" method="post">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label for="userName" class="form-label fw-semibold small text-dark" data-i18n-en="Full Name" data-i18n-tr="Ad Soyad">
                                Full Name
                            </label>
                            <input type="text" id="userName" name="Name" class="form-control" 
                                   placeholder="e.g. Dr. Eleanor Vance" 
                                   data-i18n-en="e.g. Dr. Eleanor Vance" 
                                   data-i18n-tr="Örn. Dr. Miray Destan" 
                                   required />
                        </div>
                        <div class="col-md-5">
                            <label for="userEmail" class="form-label fw-semibold small text-dark" data-i18n-en="Institutional or Personal Email" data-i18n-tr="Kurumsal veya Kişisel E-posta">
                                Institutional or Personal Email
                            </label>
                            <input type="email" id="userEmail" name="Email" class="form-control" 
                                   placeholder="e.g. eleanor.vance@alumni.edu" 
                                   data-i18n-en="e.g. eleanor.vance@alumni.edu" 
                                   data-i18n-tr="örn. miray@alumni.edu" 
                                   required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn-academic-gold w-100 py-2">
                                <i class="bi bi-check-circle me-1"></i>
                                <span data-i18n-en="Register" data-i18n-tr="Kaydet">Register</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Directory Grid / List -->
        @if (!Model.Any())
        {
            <div class="academic-empty-state my-5">
                <div class="empty-state-icon mb-3">
                    <i class="bi bi-people" style="font-size: 2.75rem; color: var(--ats-gold);"></i>
                </div>
                <h3 class="academic-heading h3 mb-2" data-i18n-en="No Alumni Registered Yet" data-i18n-tr="Henüz Mezun Kaydı Bulunmuyor">
                    No Alumni Registered Yet
                </h3>
                <p class="academic-lead mx-auto mb-4" style="max-width: 520px;" data-i18n-en="The alumni directory is currently empty. Be the first to register and establish your permanent institutional record." data-i18n-tr="Mezunlar dizini şu anda boştur. İlk kaydı oluşturarak kurumsal mezun sicilinizi başlatabilirsiniz.">
                    The alumni directory is currently empty. Be the first to register and establish your permanent institutional record.
                </p>
                <a asp-action="Create" class="btn-academic-gold" data-i18n-en="Register First Graduate" data-i18n-tr="İlk Mezun Kaydını Yap">
                    Register First Graduate
                </a>
            </div>
        }
        else
        {
            <!-- Dynamic Search No-Results Placeholder -->
            <div id="alumniNoSearchResults" class="academic-empty-state my-5" style="display: none;">
                <div class="empty-state-icon mb-3">
                    <i class="bi bi-search" style="font-size: 2.5rem; color: var(--ats-gold);"></i>
                </div>
                <h3 class="academic-heading h4 mb-2" data-i18n-en="No Matching Alumni Found" data-i18n-tr="Eşleşen Mezun Bulunamadı">
                    No Matching Alumni Found
                </h3>
                <p class="small text-muted mb-3" data-i18n-en="We could not find any graduate matching your search criteria. Try a different name, email or ID." data-i18n-tr="Arama kriterlerinize uyan mezun kaydı bulunamadı. Farklı bir isim veya e-posta deneyin.">
                    We could not find any graduate matching your search criteria. Try a different name, email or ID.
                </p>
                <button type="button" class="btn btn-outline-custom btn-sm" onclick="clearAlumniSearch()">
                    <span data-i18n-en="Clear Search Filter" data-i18n-tr="Aramayı Temizle">Clear Search Filter</span>
                </button>
            </div>

            <!-- Alumni Profile Cards Grid -->
            <div class="row g-4" id="alumniGridContainer">
                @foreach (var user in Model)
                {
                    var initials = GetInitials(user.Name);
                    <div class="col-md-6 col-lg-4 alumni-directory-card" 
                         data-alumni-id="@user.Id" 
                         data-alumni-name="@user.Name.ToLowerInvariant()" 
                         data-alumni-email="@user.Email.ToLowerInvariant()">
                        
                        <div class="card h-100 border-0 shadow-sm rounded-3 p-4 d-flex flex-column justify-content-between" 
                             style="background: #FFFFFF; border: 1px solid var(--ats-card-border) !important; border-top: 3px solid var(--ats-navy) !important; transition: var(--ats-transition);">
                            
                            <!-- Card Header: Monogram Avatar & ID Chip -->
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <!-- Monogram Avatar -->
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-inline-flex align-items-center justify-content-center fw-bold text-white rounded-circle" 
                                             style="width: 48px; height: 48px; background-color: var(--ats-navy); border: 1.5px solid var(--ats-gold); font-size: 1.1rem; letter-spacing: 0.05em;">
                                            @initials
                                        </div>
                                        <div>
                                            <span class="badge" style="background: rgba(197, 164, 109, 0.15); color: var(--ats-gold-hover); border: 1px solid var(--ats-gold-border); font-size: 0.725rem; letter-spacing: 0.05em; text-transform: uppercase;">
                                                <i class="bi bi-shield-check me-1"></i> <span data-i18n-en="Verified Member" data-i18n-tr="Doğrulanmış Üye">Verified Member</span>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Registry ID Badge -->
                                    <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.75rem;">
                                        #@user.Id
                                    </span>
                                </div>

                                <!-- Alumnus Name in Academic Serif -->
                                <h3 class="h5 academic-serif mb-2" style="color: var(--ats-navy);">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="text-decoration-none" style="color: var(--ats-navy);">
                                        @user.Name
                                    </a>
                                </h3>

                                <!-- Contact & Professional Information -->
                                <div class="mb-3 small text-secondary d-flex align-items-center gap-2">
                                    <i class="bi bi-envelope text-muted"></i>
                                    <span class="text-truncate">@user.Email</span>
                                </div>

                                <!-- Academic Affiliation Note -->
                                <p class="small text-muted mb-3" style="line-height: 1.5;" data-i18n-en="Active alumni participant connected to university networking and career initiatives." data-i18n-tr="Üniversite ağı ve kariyer girişimlerine bağlı aktif mezun topluluğu üyesi.">
                                    Active alumni participant connected to university networking and career initiatives.
                                </p>
                            </div>

                            <!-- Card Action Cluster -->
                            <div class="pt-3 border-top d-flex align-items-center justify-content-between" style="border-color: var(--ats-gray-light) !important;">
                                <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-custom btn-sm px-3">
                                    <i class="bi bi-eye me-1" style="color: var(--ats-gold);"></i>
                                    <span data-i18n-en="View Profile" data-i18n-tr="Profili İncele">View Profile</span>
                                </a>

                                <!-- Management Action Menu (Edit / Delete) -->
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm" title="Edit Profile">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-secondary btn-sm text-danger" title="Remove Record">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>

<!-- Section 3: Institutional Call-To-Action Banner -->
<section class="py-5 bg-warm-offwhite pt-0" aria-label="Alumni Career and Fellowship Banner">
    <div class="container pb-lg-4">
        <div class="closing-academic-banner text-center">
            <span class="academic-overline" style="color: var(--ats-gold);" data-i18n-en="Collegiate Fellowship" data-i18n-tr="Mezun Dayanışması">
                Collegiate Fellowship
            </span>
            <h2 class="academic-heading text-white mb-3" data-i18n-en="Engage with Our Global Alumni Community" data-i18n-tr="Küresel Mezun Topluluğumuza Katılın">
                Engage with Our Global Alumni Community
            </h2>
            <p class="closing-subtitle mx-auto mb-4" data-i18n-en="Connect with fellow graduates, explore institutional career postings, or submit your own professional opportunities." data-i18n-tr="Mezun arkadaşlarınızla bağlantı kurun, kurumsal kariyer ilanlarını inceleyin veya kendi iş fırsatlarınızı paylaşın.">
                Connect with fellow graduates, explore institutional career postings, or submit your own professional opportunities.
            </p>
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
                <a href="/JobPosting" class="btn-academic-gold" data-i18n-en="Explore Career Opportunities" data-i18n-tr="Kariyer Fırsatlarını Keşfet">
                    Explore Career Opportunities
                </a>
                <a href="/Announcement" class="btn-academic-outline" data-i18n-en="Read Campus Bulletins" data-i18n-tr="Kampüs Bültenlerini Oku">
                    Read Campus Bulletins
                </a>
                <a href="/" class="btn-academic-ghost text-white-50 text-decoration-none px-3 py-2 small" data-i18n-en="Return to Home &rarr;" data-i18n-tr="Ana Sayfaya Dön &rarr;">
                    Return to Home &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Scoped Client-Side Search & Sorting Logic -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('alumniSearchInput');
        const sortSelect = document.getElementById('alumniSortSelect');
        const cardsContainer = document.getElementById('alumniGridContainer');
        const countDisplay = document.getElementById('alumniVisibleCount');
        const noResultsMsg = document.getElementById('alumniNoSearchResults');

        function normalizeStr(str) {
            return (str || '')
                .toLowerCase()
                .replace(/ğ/g, 'g')
                .replace(/ü/g, 'u')
                .replace(/ş/g, 's')
                .replace(/ı/g, 'i')
                .replace(/ö/g, 'o')
                .replace(/ç/g, 'c')
                .trim();
        }

        function filterAndSortAlumni() {
            if (!cardsContainer) return;
            const term = normalizeStr(searchInput ? searchInput.value : '');
            const sortMode = sortSelect ? sortSelect.value : 'recent';
            const cards = Array.from(cardsContainer.querySelectorAll('.alumni-directory-card'));

            let visibleCount = 0;

            // 1. Filtering
            cards.forEach(card => {
                const name = normalizeStr(card.getAttribute('data-alumni-name') || '');
                const email = (card.getAttribute('data-alumni-email') || '').toLowerCase();
                const id = (card.getAttribute('data-alumni-id') || '').trim();

                const matches = name.includes(term) || email.includes(term) || id.includes(term);
                if (matches) {
                    card.style.display = '';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            // 2. Sorting (on visible items)
            cards.sort((a, b) => {
                if (sortMode === 'name-asc') {
                    return (a.getAttribute('data-alumni-name') || '').localeCompare(b.getAttribute('data-alumni-name') || '');
                } else if (sortMode === 'name-desc') {
                    return (b.getAttribute('data-alumni-name') || '').localeCompare(a.getAttribute('data-alumni-name') || '');
                } else if (sortMode === 'id-asc') {
                    return parseInt(a.getAttribute('data-alumni-id') || '0', 10) - parseInt(b.getAttribute('data-alumni-id') || '0', 10);
                } else {
                    // 'recent' -> ID descending
                    return parseInt(b.getAttribute('data-alumni-id') || '0', 10) - parseInt(a.getAttribute('data-alumni-id') || '0', 10);
                }
            });

            cards.forEach(card => cardsContainer.appendChild(card));

            // 3. Update counter and empty state
            if (countDisplay) countDisplay.textContent = visibleCount;
            if (noResultsMsg) {
                noResultsMsg.style.display = (visibleCount === 0 && cards.length > 0) ? 'block' : 'none';
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', filterAndSortAlumni);
        }
        if (sortSelect) {
            sortSelect.addEventListener('change', filterAndSortAlumni);
        }

        window.clearAlumniSearch = function () {
            if (searchInput) {
                searchInput.value = '';
                filterAndSortAlumni();
                searchInput.focus();
            }
        };
    });
</script>
