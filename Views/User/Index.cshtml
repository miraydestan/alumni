@model IEnumerable<Alumni.Models.User>

@{
    ViewData["Title"] = "Users";
    ViewData["ActivePage"] = "Users";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">User Management</h1>
            <p class="text-secondary mb-0">Manage system users, view details, update information, or create new users.</p>
        </div>
        <a asp-action="Create" class="btn btn-outline-custom">
            <i class="bi bi-person-plus me-1"></i> Full Create Page
        </a>
    </div>

    <!-- Quick Create Form (POST /users) -->
    <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
        <h2 class="h5 fw-bold text-dark mb-3">
            <i class="bi bi-plus-circle me-1 text-primary"></i> Create New User
        </h2>
        <form action="/users" method="post">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="userName" class="form-label fw-semibold small text-dark">Name</label>
                    <input type="text" id="userName" name="Name" class="form-control" placeholder="e.g. John Doe" required />
                </div>
                <div class="col-md-5">
                    <label for="userEmail" class="form-label fw-semibold small text-dark">Email</label>
                    <input type="email" id="userEmail" name="Email" class="form-control" placeholder="e.g. john@example.com" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary-custom w-100">
                        <i class="bi bi-check-circle me-1"></i> Add User
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- User Listing (GET /users) -->
    @if (!Model.Any())
    {
        <div class="info-card text-center py-5">
            <div class="icon-box mx-auto mb-3">
                <i class="bi bi-people"></i>
            </div>
            <h3 class="card-heading">No Users Found</h3>
            <p class="card-description mb-0">There are currently no users in the in-memory store. Use the form above to add one.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 100px;">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="text-end" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark border">#@user.Id</span>
                                </td>
                                <td class="fw-semibold text-dark">@user.Name</td>
                                <td class="text-secondary">@user.Email</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
