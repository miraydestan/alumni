@model Alumni.Models.User

@{
    ViewData["Title"] = "Delete User";
    ViewData["ActivePage"] = "Users";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3 p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="icon-box m-0 bg-danger-subtle text-danger">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div>
                        <h2 class="card-heading mb-0 text-danger">Delete User</h2>
                        <span class="text-secondary small">Are you sure you want to delete this user?</span>
                    </div>
                </div>

                <div class="alert alert-warning py-2 small mb-4">
                    <i class="bi bi-info-circle me-1"></i> This action will remove the user from the in-memory store.
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small d-block">ID</span>
                    <span class="fs-6 fw-semibold text-dark">#@Model.Id</span>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <span class="text-muted small d-block">Name</span>
                    <span class="fs-5 fw-semibold text-dark">@Model.Name</span>
                </div>

                <div class="mb-4">
                    <span class="text-muted small d-block">Email</span>
                    <span class="fs-6 text-secondary">@Model.Email</span>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Delete User
                        </button>
                        <a asp-action="Index" class="btn btn-outline-custom px-3">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
