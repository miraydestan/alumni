@model Alumni.Models.Admin.AdminUserDetailsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"User Details - {Model.User.Name}";
    ViewData["ActiveAdminTab"] = "Users";
}

<div class="row g-4">
    <!-- User Overview Card -->
    <div class="col-lg-4">
        <div class="admin-card p-4 text-center">
            <div class="icon-box mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem; background: rgba(27, 42, 74, 0.08); color: var(--ats-navy); border-radius: 50%;">
                <i class="bi bi-person-circle"></i>
            </div>

            <h4 class="fw-bold mb-1 text-dark">@Model.User.Name</h4>
            <div class="text-muted small mb-3">@Model.User.Email</div>

            <div class="mb-4">
                @if (Model.User.Role == "Administrator")
                {
                    <span class="badge badge-role-admin py-1 px-3 fs-6">Administrator</span>
                }
                else if (Model.User.Role == "Student")
                {
                    <span class="badge badge-role-student py-1 px-3 fs-6">Student</span>
                }
                else
                {
                    <span class="badge badge-role-alumni py-1 px-3 fs-6">Alumni</span>
                }
            </div>

            <div class="d-flex justify-content-center gap-2 border-top pt-3">
                <a href="/Admin/Users/Edit/@Model.User.Id" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-pencil me-1"></i> Edit Profile
                </a>
                @if (!Model.IsCurrentAdmin)
                {
                    <a href="/Admin/Users/Delete/@Model.User.Id" class="btn btn-outline-danger btn-sm px-3">
                        <i class="bi bi-trash me-1"></i> Delete
                    </a>
                }
            </div>
        </div>

        <div class="admin-card p-4 mt-4">
            <h6 class="fw-bold mb-3 text-dark pb-2 border-bottom">System Metadata</h6>
            <div class="d-flex justify-content-between py-1 small">
                <span class="text-muted">Database Record ID:</span>
                <span class="fw-semibold">#@Model.User.Id</span>
            </div>
            <div class="d-flex justify-content-between py-1 small">
                <span class="text-muted">Job Postings Authored:</span>
                <span class="fw-semibold">@Model.JobPostings.Count</span>
            </div>
            <div class="d-flex justify-content-between py-1 small">
                <span class="text-muted">Applications Submitted:</span>
                <span class="fw-semibold">@Model.Applications.Count</span>
            </div>
        </div>
    </div>

    <!-- Related Domain Activity -->
    <div class="col-lg-8">
        <!-- Job Postings -->
        <div class="admin-card p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Authored Job Postings (@Model.JobPostings.Count)</h5>
            </div>

            @if (Model.JobPostings.Count == 0)
            {
                <p class="text-muted small mb-0">This user has not authored any career postings in the system.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>ID</th>
                                <th>Job Title</th>
                                <th>Company</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in Model.JobPostings)
                            {
                                <tr>
                                    <td class="text-muted small">#@job.Id</td>
                                    <td class="fw-semibold">@job.Title</td>
                                    <td>@job.Company</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Applications -->
        <div class="admin-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">Submitted Job Applications (@Model.Applications.Count)</h5>
            </div>

            @if (Model.Applications.Count == 0)
            {
                <p class="text-muted small mb-0">This user has not submitted any job applications.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>ID</th>
                                <th>Job Posting Title</th>
                                <th>Company</th>
                                <th>Application Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td class="text-muted small">#@app.Id</td>
                                    <td class="fw-semibold">@(app.JobPosting?.Title ?? $"Job #{app.JobPostingId}")</td>
                                    <td>@(app.JobPosting?.Company ?? "—")</td>
                                    <td><span class="badge bg-secondary">@app.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="mt-4">
            <a href="/Admin/Users" class="btn btn-outline-secondary">
                &larr; Return to Users List
            </a>
        </div>
    </div>
</div>
