@model Alumni.Models.Admin.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Executive Dashboard";
    ViewData["ActiveAdminTab"] = "Dashboard";
}

<!-- Row 1: Primary Metrics -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(27, 42, 74, 0.1); color: var(--ats-navy);">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Total Users</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalUsers</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(221, 168, 59, 0.15); color: #B45309;">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Alumni Members</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalAlumni</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(16, 185, 129, 0.15); color: #047857;">
                <i class="bi bi-backpack-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Enrolled Students</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalStudents</div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(220, 53, 69, 0.12); color: #DC2626;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Administrators</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalAdministrators</div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Secondary Institutional Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(13, 110, 253, 0.1); color: #0D6EFD;">
                <i class="bi bi-megaphone-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Announcements</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalAnnouncements</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(102, 16, 242, 0.1); color: #6610F2;">
                <i class="bi bi-briefcase-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Job Postings</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalJobPostings</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="admin-metric-card">
            <div class="admin-metric-icon" style="background: rgba(253, 126, 20, 0.1); color: #FD7E14;">
                <i class="bi bi-file-earmark-person-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">Career Applications</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalApplications</div>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Recent Registrations & Quick Governance -->
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Recent User Registrations</h5>
                    <span class="text-muted small">Latest system members registered or imported into the database</span>
                </div>
                <a href="/Admin/Users" class="btn btn-sm btn-outline-primary py-1 px-3">
                    View All Users &rarr;
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email Address</th>
                            <th>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.RecentUsers)
                        {
                            <tr>
                                <td class="fw-semibold text-muted small">#@user.Id</td>
                                <td class="fw-semibold text-dark">@user.Name</td>
                                <td class="text-muted small">@user.Email</td>
                                <td>
                                    @if (user.Role == "Administrator")
                                    {
                                        <span class="badge badge-role-admin py-1 px-2 small">Administrator</span>
                                    }
                                    else if (user.Role == "Student")
                                    {
                                        <span class="badge badge-role-student py-1 px-2 small">Student</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-role-alumni py-1 px-2 small">Alumni</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/Users/Details/@user.Id" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/Admin/Users/Edit/@user.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Operations -->
    <div class="col-lg-4">
        <div class="admin-card p-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark pb-2 border-bottom">Administration Actions</h5>
            <div class="d-flex flex-column gap-2">
                <a href="/Admin/Users/Create" class="btn btn-academic-gold text-start py-2 px-3 fw-semibold">
                    <i class="bi bi-person-plus-fill me-2"></i> Add New Member Account
                </a>
                <a href="/Admin/Users" class="btn btn-outline-secondary text-start py-2 px-3 fw-semibold">
                    <i class="bi bi-people me-2"></i> Manage All Registered Users
                </a>
                <a href="/AnnouncementAdmin" class="btn btn-outline-secondary text-start py-2 px-3 fw-semibold">
                    <i class="bi bi-megaphone me-2"></i> Publish Campus Bulletin
                </a>
                <a href="/api/swagger" target="_blank" class="btn btn-outline-secondary text-start py-2 px-3 fw-semibold">
                    <i class="bi bi-code-slash me-2"></i> Swagger REST API Docs
                </a>
            </div>
        </div>

        <div class="admin-card p-4">
            <h6 class="fw-bold mb-2 text-dark">Security Guard Active</h6>
            <p class="text-muted small mb-0" style="line-height: 1.5;">
                All administrative controllers are secured with <code>[Authorize(Roles = "Administrator")]</code>. Self-deletion and privilege revocation protection are actively enforced.
            </p>
        </div>
    </div>
</div>
