@model Alumni.Models.Admin.AdminUserEditViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Edit User #{Model.Id}";
    ViewData["ActiveAdminTab"] = "Users";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="admin-card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                <div>
                    <h4 class="fw-bold mb-1 text-dark">Modify User Account</h4>
                    <span class="text-muted small">Update profile details, change system role, or reset password</span>
                </div>
                <a href="/Admin/Users" class="btn btn-sm btn-outline-secondary">
                    &larr; Back to Users
                </a>
            </div>

            @if (Model.IsCurrentAdmin)
            {
                <div class="alert alert-warning py-2 small mb-4 rounded d-flex align-items-center" role="alert">
                    <i class="bi bi-shield-lock-fill me-2 fs-5"></i>
                    <div>
                        <strong>Self-Account Safety Notice:</strong> You are currently editing your own administrator account. The Administrator role cannot be revoked to preserve system governance.
                    </div>
                </div>
            }

            <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsCurrentAdmin" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4 rounded" role="alert"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-dark">Full Name *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-person"></i></span>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small text-dark">Institutional Email Address *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Role Selection -->
                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-semibold small text-dark">System Authorization Role *</label>
                    @if (Model.IsCurrentAdmin)
                    {
                        <select asp-for="Role" class="form-select" disabled>
                            <option value="Administrator" selected>Administrator &bull; Full Governance Privileges</option>
                        </select>
                        <input type="hidden" asp-for="Role" value="Administrator" />
                        <div class="form-text small text-muted">Role is locked for active administrative session to prevent lockouts.</div>
                    }
                    else
                    {
                        <select asp-for="Role" class="form-select" required>
                            <option value="Alumni">Alumni &bull; Verified Graduate</option>
                            <option value="Student">Student &bull; Active Enrollee</option>
                            <option value="Administrator">Administrator &bull; Full Governance Privileges</option>
                        </select>
                    }
                    <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Password Reset Section -->
                <div class="border-top pt-4 mb-4">
                    <h6 class="fw-bold mb-1 text-dark">Reset Password (Optional)</h6>
                    <p class="text-muted small mb-3">Leave these fields blank if you do not wish to change the user's password.</p>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-dark">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" minlength="6" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small text-dark">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="/Admin/Users" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
