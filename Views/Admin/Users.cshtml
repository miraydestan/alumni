@model IEnumerable<Alumni.Models.User>
@using System.Security.Claims

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
    ViewData["ActiveAdminTab"] = "Users";

    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int.TryParse(currentUserIdStr, out var currentUserId);
    var currentUserEmail = User.FindFirstValue(ClaimTypes.Email);

    var searchQuery = ViewData["SearchQuery"] as string ?? "";
    var selectedRole = ViewData["SelectedRole"] as string ?? "";
}

<div class="admin-card p-4">
    <!-- Top Action & Search Bar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h4 class="fw-bold mb-1 text-dark">Institutional User Directory</h4>
            <span class="text-muted small">Manage accounts, assign roles, and audit access permissions</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Admin/Users/Create" class="btn btn-academic-gold py-2 px-3 fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i> Add New User
            </a>
        </div>
    </div>

    <!-- Filter & Search Form -->
    <form method="get" action="/Admin/Users" class="row g-2 mb-4">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="q" value="@searchQuery" class="form-control border-start-0" placeholder="Search by name or email..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="role" class="form-select">
                <option value="">All System Roles</option>
                <option value="Administrator" selected="@(selectedRole == "Administrator")">Administrator</option>
                <option value="Alumni" selected="@(selectedRole == "Alumni")">Alumni</option>
                <option value="Student" selected="@(selectedRole == "Student")">Student</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary px-3">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(selectedRole))
            {
                <a href="/Admin/Users" class="btn btn-outline-secondary px-3">
                    Reset
                </a>
            }
        </div>
    </form>

    <!-- Users Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                <tr>
                    <th style="width: 70px;">ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th style="width: 140px;">Role</th>
                    <th style="width: 180px;" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            No user records match your filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        var isCurrentAdmin = (user.Id == currentUserId) ||
                            (!string.IsNullOrEmpty(currentUserEmail) && string.Equals(user.Email, currentUserEmail, StringComparison.OrdinalIgnoreCase));

                        <tr class="@(isCurrentAdmin ? "table-light" : "")">
                            <td class="fw-bold text-muted small">#@user.Id</td>
                            <td>
                                <div class="fw-bold text-dark">
                                    @user.Name
                                    @if (isCurrentAdmin)
                                    {
                                        <span class="badge bg-primary text-white ms-1 py-0 px-2" style="font-size: 0.65rem;">YOU</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@user.Email" class="text-decoration-none text-muted small">
                                    @user.Email
                                </a>
                            </td>
                            <td>
                                @if (user.Role == "Administrator")
                                {
                                    <span class="badge badge-role-admin py-1 px-2 small">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Administrator
                                    </span>
                                }
                                else if (user.Role == "Student")
                                {
                                    <span class="badge badge-role-student py-1 px-2 small">
                                        <i class="bi bi-backpack-fill me-1"></i> Student
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-role-alumni py-1 px-2 small">
                                        <i class="bi bi-mortarboard-fill me-1"></i> Alumni
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Admin/Users/Details/@user.Id" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a href="/Admin/Users/Edit/@user.Id" class="btn btn-outline-primary" title="Edit User">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    @if (!isCurrentAdmin)
                                    {
                                        <a href="/Admin/Users/Delete/@user.Id" class="btn btn-outline-danger" title="Delete User">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary disabled" title="Cannot delete own account">
                                            <i class="bi bi-shield-slash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
