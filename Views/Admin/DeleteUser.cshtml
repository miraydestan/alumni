@model Alumni.Models.Admin.AdminUserDetailsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Delete User #{Model.User.Id}";
    ViewData["ActiveAdminTab"] = "Users";

    var hasDependencies = Model.JobPostings.Count > 0 || Model.Applications.Count > 0;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="admin-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="icon-box mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem; background: rgba(220, 53, 69, 0.1); color: #DC2626; border-radius: 50%;">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h4 class="fw-bold text-dark mb-1">Confirm Account Removal</h4>
                <p class="text-muted small">Are you sure you want to permanently delete this user record from the database?</p>
            </div>

            <!-- User Information Summary -->
            <div class="border rounded p-3 mb-4 bg-light">
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted">User ID:</span>
                    <span class="fw-bold">#@Model.User.Id</span>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted">Full Name:</span>
                    <span class="fw-bold">@Model.User.Name</span>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted">Email:</span>
                    <span class="fw-bold">@Model.User.Email</span>
                </div>
                <div class="d-flex justify-content-between py-1 small">
                    <span class="text-muted">Role:</span>
                    <span class="badge @(Model.User.Role == "Administrator" ? "badge-role-admin" : Model.User.Role == "Student" ? "badge-role-student" : "badge-role-alumni")">
                        @Model.User.Role
                    </span>
                </div>
            </div>

            @if (Model.IsCurrentAdmin)
            {
                <div class="alert alert-danger py-3 small mb-4 rounded d-flex align-items-center" role="alert">
                    <i class="bi bi-shield-x me-2 fs-4"></i>
                    <div>
                        <strong>Self-Deletion Prohibited:</strong> You cannot delete the active administrator account you are currently logged in with.
                    </div>
                </div>
                <div class="text-center">
                    <a href="/Admin/Users" class="btn btn-outline-secondary px-4">Return to User Directory</a>
                </div>
            }
            else if (hasDependencies)
            {
                <div class="alert alert-warning py-3 small mb-4 rounded" role="alert">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-shield-exclamation me-2 fs-4 text-warning"></i>
                        <strong class="text-dark">Active Record Dependencies Detected</strong>
                    </div>
                    <p class="mb-0 text-muted" style="line-height: 1.5;">
                        This user owns <strong>@Model.JobPostings.Count</strong> job postings and <strong>@Model.Applications.Count</strong> job applications. In accordance with database safety constraints (<code>ON DELETE RESTRICT</code>), users with active domain records cannot be removed until their dependencies are reassigned or deleted.
                    </p>
                </div>
                <div class="text-center">
                    <a href="/Admin/Users/Details/@Model.User.Id" class="btn btn-outline-primary px-3 me-2">Inspect Dependencies</a>
                    <a href="/Admin/Users" class="btn btn-outline-secondary px-3">Return to User Directory</a>
                </div>
            }
            else
            {
                <form asp-action="DeleteUserConfirmed" asp-route-id="@Model.User.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/Admin/Users" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold">
                            <i class="bi bi-trash-fill me-1"></i> Permanently Delete User
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
